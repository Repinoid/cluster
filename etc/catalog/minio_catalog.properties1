# Iceberg connector configuration
connector.name=iceberg
iceberg.catalog.type=hive_metastore

# CORRECT warehouse location property for Iceberg
# iceberg.warehouse=s3a://warehouse/

# Hive metastore configuration
hive.metastore.uri=thrift://metastore:9083

# S3 configuration
fs.native-s3.enabled=true
s3.aws-access-key=muser
s3.aws-secret-key=mpassword
s3.region=eu-central-1
s3.endpoint=http://minio-service:9000
s3.path-style-access=true

s3.sts.region=eu-central-1


s3.canned-acl=PUBLIC_READ_WRITE

# s3.access-key-id=your-access-key
# s3.secret-access-key=your-secret-key